{
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.12"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-run dev.js",
    "build": "imp build islands/main.js --output public/islands",
    "start": "deno run --allow-net --allow-read --allow-env server/main.js"
  },
  "fmt": { "lineWidth": 100, "singleQuote": true, "semiColons": false },
  "exclude": ["public/islands/"]
}
